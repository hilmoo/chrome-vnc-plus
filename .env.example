# --- display ---
RESOLUTION=1280x720
DEPTH=24
# --- services (true/false). noVNC needs its matching VNC server ---
VNC_RW_ENABLED=true
VNC_RO_ENABLED=true
NOVNC_RW_ENABLED=true
NOVNC_RO_ENABLED=true
# --- auth (empty = no password) ---
VNC_PASSWORD=changeme
VNC_VIEW_PASSWORD=          # defaults to VNC_PASSWORD
API_TOKEN=                  # protects /screenshot: ?token=... or "Authorization: Bearer ..."
# --- chrome ---
START_URL=https://www.google.com
RESTORE_SESSION=true
# CHROME_ARGS replaces the default flags; CHROME_EXTRA_ARGS appends to them
# CHROME_ARGS=--no-sandbox --disable-dev-shm-usage
CHROME_EXTRA_ARGS=--lang=en-US
CHROME_PROFILE_DIR=/data/profile
CDP_PROXY_PORT=             # e.g. 9223 to expose CDP (then also publish the port)
# --- MCP ---
MCP_ENABLED=true
MCP_EXTRA_ARGS=             # extra chrome-devtools-mcp flags
